rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function bloodType(v) { return v in ['O-', 'O+', 'A-', 'A+', 'B-', 'B+', 'AB-', 'AB+']; }
    function str(v, max) { return v is string && v.size() <= max; }
    function lat(v) { return v is number && v >= -90 && v <= 90; }
    function lng(v) { return v is number && v >= -180 && v <= 180; }

    // Private profile: only the owner can read or write. No "verified" or role fields can be self-assigned.
    match /users/{uid} {
      allow read, delete: if isMe(uid);
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['name', 'phone', 'bloodType', 'city', 'lat', 'lng', 'available', 'lastDonationDate', 'createdAt', 'updatedAt'])
        && str(request.resource.data.name, 80) && request.resource.data.name.size() > 0
        && str(request.resource.data.phone, 20)
        && bloodType(request.resource.data.bloodType)
        && str(request.resource.data.city, 60)
        && lat(request.resource.data.lat) && lng(request.resource.data.lng)
        && request.resource.data.available is bool
        && str(request.resource.data.lastDonationDate, 10);
    }

    // Public donor card (first name, group, city, location rounded to ~1 km).
    match /donors/{uid} {
      allow read: if signedIn();
      allow delete: if isMe(uid);
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'bloodType', 'city', 'approxLat', 'approxLng', 'available', 'lastDonationDate', 'updatedAt'])
        && str(request.resource.data.displayName, 40)
        && bloodType(request.resource.data.bloodType)
        && str(request.resource.data.city, 60)
        && lat(request.resource.data.approxLat) && lng(request.resource.data.approxLng)
        && request.resource.data.available is bool
        && str(request.resource.data.lastDonationDate, 10)
        && request.resource.data.updatedAt == request.time;
    }

    match /requests/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['requesterId', 'requesterName', 'patientLabel', 'bloodType', 'units', 'hospitalName', 'hospitalAddress', 'city', 'lat', 'lng', 'urgency', 'status', 'notes', 'createdAt'])
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && bloodType(request.resource.data.bloodType)
        && request.resource.data.units is int && request.resource.data.units >= 1 && request.resource.data.units <= 20
        && str(request.resource.data.requesterName, 40)
        && str(request.resource.data.patientLabel, 60)
        && str(request.resource.data.hospitalName, 120) && request.resource.data.hospitalName.size() > 0
        && str(request.resource.data.hospitalAddress, 200)
        && str(request.resource.data.city, 60)
        && lat(request.resource.data.lat) && lng(request.resource.data.lng)
        && request.resource.data.urgency in ['critical', 'standard']
        && str(request.resource.data.notes, 300);
      // Only the requester can close an active request, and only the status can change.
      allow update: if isMe(resource.data.requesterId)
        && resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['fulfilled', 'cancelled'];
      allow delete: if false;
    }

    match /threads/{tid} {
      function participant() { return signedIn() && request.auth.uid in resource.data.participants; }
      allow get: if signedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow list: if participant();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['participants', 'names', 'requestId', 'lastMessage', 'updatedAt'])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants[0] < request.resource.data.participants[1]
        && tid == request.resource.data.participants[0] + '_' + request.resource.data.participants[1]
        && request.resource.data.names is map && request.resource.data.names.size() == 2
        && str(request.resource.data.requestId, 40)
        && request.resource.data.lastMessage == ''
        && request.resource.data.updatedAt == request.time;
      allow update: if participant()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt'])
        && str(request.resource.data.lastMessage, 120)
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /messages/{mid} {
        function inThread() { return signedIn() && request.auth.uid in get(/databases/$(database)/documents/threads/$(tid)).data.participants; }
        allow read: if inThread();
        allow create: if inThread()
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
